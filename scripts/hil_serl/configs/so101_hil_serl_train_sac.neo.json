{
  "output_dir": "outputs/hil_serl/train/replace_me",
  "job_name": "so101_hil_serl_sac",
  "resume": false,
  "batch_size": 16,
  "log_freq": 10,
  "save_freq": 200,
  "wandb": {
    "enable": false,
    "project": "so101-hil-serl"
  },
  "dataset": {
    "repo_id": "replace_with_demo_dataset_repo_id",
    "root": "replace_with_demo_dataset_root"
  },
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "task": "replace_with_task_name",
    "fps": 10,
    "robot": {
      "type": "bi_so_follower",
      "id": "my_so101_follower",
      "left_arm_config": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61032646-if00",
        "use_degrees": true,
        "cameras": {
          "wrist": {
            "type": "opencv",
            "index_or_path": "/dev/v4l/by-path/pci-0000:0e:00.0-usb-0:3:1.0-video-index0",
            "width": 640,
            "height": 480,
            "fps": 30,
            "rotation": 180,
            "fourcc": "YUYV"
          }
        }
      },
      "right_arm_config": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61034934-if00",
        "use_degrees": true,
        "cameras": {
          "wrist": {
            "type": "opencv",
            "index_or_path": "/dev/v4l/by-path/pci-0000:0e:00.0-usb-0:2:1.0-video-index0",
            "width": 640,
            "height": 480,
            "fps": 30,
            "rotation": 180,
            "fourcc": "YUYV"
          },
          "front": {
            "type": "opencv",
            "index_or_path": "/dev/v4l/by-path/pci-0000:0e:00.0-usb-0:5:1.0-video-index0",
            "width": 640,
            "height": 480,
            "fps": 30,
            "rotation": 180,
            "fourcc": "MJPG"
          }
        }
      }
    },
    "teleop": {
      "type": "bi_so_leader",
      "id": "my_so101_leader",
      "left_arm_config": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61035982-if00",
        "use_degrees": true
      },
      "right_arm_config": {
        "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61032643-if00",
        "use_degrees": true
      }
    },
    "processor": {
      "control_mode": "joint_direct",
      "observation": {
        "display_cameras": false,
        "add_joint_velocity_to_observation": true
      },
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [
          224,
          224
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "reset_time_s": 4.0,
        "control_time_s": 10.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": null,
      "reward_classifier": {
        "pretrained_path": "replace_with_reward_classifier_pretrained_path",
        "success_threshold": 0.7,
        "success_reward": 1.0
      }
    }
  },
  "policy": {
    "type": "sac",
    "device": "cuda",
    "storage_device": "cpu",
    "vision_encoder_name": "helper2424/resnet10",
    "freeze_vision_encoder": true,
    "shared_encoder": true,
    "online_steps": 20000,
    "online_step_before_learning": 64,
    "online_buffer_capacity": 100000,
    "offline_buffer_capacity": 100000,
    "policy_update_freq": 1,
    "utd_ratio": 1,
    "discount": 0.99,
    "actor_lr": 0.0001,
    "critic_lr": 0.0001,
    "temperature_lr": 0.0001,
    "temperature_init": 0.01,
    "critic_target_update_weight": 0.005,
    "grad_clip_norm": 40.0,
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 1,
      "queue_get_timeout": 0.1
    },
    "concurrency": {
      "actor": "threads",
      "learner": "threads"
    },
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          24
        ]
      },
      "observation.images.left_wrist": {
        "type": "VISUAL",
        "shape": [
          3,
          224,
          224
        ]
      },
      "observation.images.right_wrist": {
        "type": "VISUAL",
        "shape": [
          3,
          224,
          224
        ]
      },
      "observation.images.right_front": {
        "type": "VISUAL",
        "shape": [
          3,
          224,
          224
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          12
        ]
      }
    }
  }
}
