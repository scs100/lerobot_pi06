# Copy to so101_bi_three_cam.env and adjust paths (do not commit secrets).
# Install tools: sudo apt-get install -y v4l-utils
#
# Two USB cameras on this machine often map to:
#   usb-0:2 -> ...-video-index0
#   usb-0:3 -> ...-video-index0
# Plug a third camera and add its ...-video-index0 path as CAM_FRONT.

export CAM_LEFT=/dev/v4l/by-path/pci-0000:0e:00.0-usb-0:3:1.0-video-index0
export CAM_RIGHT=/dev/v4l/by-path/pci-0000:0e:00.0-usb-0:2:1.0-video-index0
export CAM_FRONT=/dev/v4l/by-path/pci-0000:0e:00.0-usb-0:5:1.0-video-index0
export CAM_ROTATION=180

# Serial arms (stable paths; unaffected by ttyACM reorder after reboot)
export LEFT_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61032646-if00
export RIGHT_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61034934-if00
export LEFT_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61035982-if00
export RIGHT_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B61032643-if00

export ROBOT_ID=my_so101_follower
export TELEOP_ID=my_so101_leader
# Auto-write saved calibration to motors on startup (skip ENTER prompt).
export LEROBOT_AUTO_USE_CALIBRATION=true

export CAM_WIDTH=640
export CAM_HEIGHT=480

export CAM_LEFT_FOURCC=YUYV
export CAM_RIGHT_FOURCC=YUYV
export CAM_FRONT_FOURCC=MJPG
export CAM_LEFT_FPS=30
export CAM_RIGHT_FPS=30
export CAM_FRONT_FPS=30
export PLAY_SOUNDS=false
# Episode control defaults:
# - wait for explicit start key each episode
# - no reset wait between episodes
# - effectively unlimited episode duration (finish with END key)
export WAIT_FOR_EPISODE_START=true
export DATASET_NUM_EPISODES=50
export DATASET_EPISODE_TIME_S=86400
export DATASET_RESET_TIME_S=0
export DATASET_PUSH_TO_HUB=false
export DATASET_VCODEC=h264
export DATASET_RESUME=false
export EPISODE_START_KEY=pagedown
export EPISODE_END_KEY=end
export EPISODE_DISCARD_KEY=home
# Disable intervention toggle key for pure teleop recording.
export INTERVENTION_TOGGLE_KEY=none
# Disable global LEFT/RIGHT shortcut handling during recording.
export LEROBOT_ENABLE_ARROW_HOTKEYS=false
